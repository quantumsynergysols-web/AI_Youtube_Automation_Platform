# ViralPilot development defaults (localhost)
# Production values for app.viralpilot.io are shown beside the public URL settings.
# ---- shared ----
NODE_ENV=development
LOG_LEVEL=debug

# ---- datastores ----
DATABASE_URL=postgresql://ytap:ytap@localhost:5432/ytap?schema=public
REDIS_URL=redis://localhost:6379

# ---- worker ----
# Returns jobs abandoned in the processing list to pending on boot.
# Safe with a single worker only — set to 0 before scaling out.
WORKER_RECLAIM_ON_START=1
WORKER_QUEUE=default

# ---- api ----
API_PORT=4300
API_PUBLIC_URL=http://localhost:4300
WEB_PUBLIC_URL=http://localhost:5273
# Production:
# API_PUBLIC_URL=https://app.viralpilot.io
# WEB_PUBLIC_URL=https://app.viralpilot.io
JWT_ACCESS_SECRET=replace-me-with-32-bytes-min-abcdefghijkl
JWT_REFRESH_SECRET=replace-me-with-another-32-bytes-abcdefgh
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# ---- stripe (test mode) ----
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_STARTER=price_xxx
STRIPE_PRICE_CREATOR=price_xxx
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_STUDIO=price_xxx

# ---- google sign-in (FR-1.2) ----
# OAuth 2.0 Web application client id from Google Cloud Console.
# Leave blank to disable; the route then returns 501 instead of failing oddly.
GOOGLE_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# ---- channel connection (FR-2) ----
# Same OAuth client as above, but the code flow needs the secret and a redirect URI.
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4300/api/channels/callback
# Production: GOOGLE_REDIRECT_URI=https://app.viralpilot.io/api/channels/callback

# Encrypts OAuth tokens at rest. Generate with: openssl rand -base64 32
# Rotating this makes every stored channel token undecryptable — they must reconnect.
TOKEN_ENCRYPTION_KEY=

# ---- email (Phase 0 logs to console when unset) ----
SMTP_URL=
MAIL_FROM="ViralPilot <no-reply@viralpilot.io>"

# ---- storage (wired in Phase 2) ----
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- web ----
VITE_API_URL=http://localhost:4300
# Production: VITE_API_URL=https://app.viralpilot.io
